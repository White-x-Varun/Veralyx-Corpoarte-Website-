# Copy to backend/.env and frontend/.env as needed.
# Never commit real secrets.

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/veralyx
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
UPLOAD_MAX_BYTES=5242880
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
# R2 (production)
# STORAGE_PROVIDER=r2
# Cloudflare Worker deployments use the RESUME_BUCKET binding in backend/wrangler.jsonc.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# Seed first admin (development / one-time setup only)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_SEED_NAME=Site Administrator

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SITE_URL=http://localhost:5173
