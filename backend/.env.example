# Copy to backend/.env — never commit real secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/veralyx
CLIENT_ORIGIN=http://localhost:5173

# Session / JWT signing (min 32 characters in production)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Cookie security — set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF double-submit cookie (set false in automated tests)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=veralyx_csrf

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_MAX=5
APPLY_RATE_LIMIT_MAX=10

# Uploads
UPLOAD_MAX_BYTES=5242880

# Storage: local | r2
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# Cloudflare R2 (S3-compatible) — production
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=veralyx-uploads
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=

# Seed first admin (development / one-time setup only)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMeImmediately123!
ADMIN_SEED_NAME=Site Administrator
