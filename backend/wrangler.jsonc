{
  "name": "veralyx-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "VERALYX_RUNTIME": "cloudflare-worker",
    "COOKIE_SECURE": "true",
    "COOKIE_SAME_SITE": "lax",
    "CSRF_ENABLED": "true",
    "STORAGE_PROVIDER": "r2",
    "UPLOAD_MAX_BYTES": "5242880",
    "RATE_LIMIT_WINDOW_MS": "900000",
    "RATE_LIMIT_MAX": "100",
    "LOGIN_RATE_LIMIT_MAX": "10",
    "CONTACT_RATE_LIMIT_MAX": "5",
    "APPLY_RATE_LIMIT_MAX": "10"
  },
  "r2_buckets": [
    {
      "binding": "RESUME_BUCKET",
      "bucket_name": "veralyx-resumes"
    }
  ]
}
