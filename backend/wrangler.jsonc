{
  "name": "veralyx-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "secrets": {
    "required": ["MONGODB_URI", "SESSION_SECRET"]
  },
  "ratelimits": [
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "2026103101",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026103102",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026103103",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "APPLY_RATE_LIMITER",
      "namespace_id": "2026103104",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "VERALYX_RUNTIME": "cloudflare-worker",
    "COOKIE_SECURE": "true",
    "COOKIE_SAME_SITE": "lax",
    "CSRF_ENABLED": "true",
    "STORAGE_PROVIDER": "mongodb",
    "UPLOAD_MAX_BYTES": "5242880",
    "RATE_LIMIT_WINDOW_MS": "900000",
    "RATE_LIMIT_MAX": "100",
    "LOGIN_RATE_LIMIT_MAX": "10",
    "CONTACT_RATE_LIMIT_MAX": "5",
    "APPLY_RATE_LIMIT_MAX": "10"
  }
}
